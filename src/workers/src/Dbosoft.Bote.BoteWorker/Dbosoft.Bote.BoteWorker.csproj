<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Azure.Data.Tables" Version="12.9.1" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
    <PackageReference Include="Azure.Storage.Queues" Version="12.22.0" />
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.2" />
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" Version="2.23.0" />
    <PackageReference Include="Microsoft.Azure.AppConfiguration.Functions.Worker" Version="8.2.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.51.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Blobs" Version="6.8.2" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" Version="5.5.5" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.ServiceBus" Version="5.24.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.SignalRService" Version="2.1.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.12.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.12.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\client\src\Dbosoft.Bote.Transport.Abstractions\Dbosoft.Bote.Transport.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Dbosoft.Bote.Abstractions.SignalR\Dbosoft.Bote.Abstractions.SignalR.csproj" />
    <ProjectReference Include="..\..\..\Dbosoft.Bote.AppConfiguration\Dbosoft.Bote.AppConfiguration.csproj" />
    <ProjectReference Include="..\..\..\Dbosoft.Bote.Options\Dbosoft.Bote.Options.csproj" />
    <ProjectReference Include="..\..\..\Dbosoft.Bote.Primitives\Dbosoft.Bote.Primitives.csproj" />
    <ProjectReference Include="..\..\..\Dbosoft.Bote.Rebus.Integration\Dbosoft.Bote.Rebus.Integration.csproj" />
  </ItemGroup>
  <!--
    The blob extension the Functions host loads is the one the worker package names: 6.8.2 names
    5.3.8, whose container scan finds only blobs written before the host's first poll, so attachments
    from the cloud reach a client only after a restart (Azure/azure-sdk-for-net#61660, fixed in
    5.3.10). No worker package names 5.3.10 yet and the SDK takes no override, so the generated
    extension project is pointed at it here. The build fails once the worker package names another
    version: then this target is to go.
  -->
  <PropertyGroup>
    <_BlobsExtensionNamed>5.3.8</_BlobsExtensionNamed>
    <_BlobsExtensionFixed>5.3.10</_BlobsExtensionFixed>
  </PropertyGroup>
  <Target Name="_PinFixedBlobsExtension" AfterTargets="_FunctionsGenerateCommon" Condition="'$(_FunctionsBuildEnabled)' == 'true'">
    <PropertyGroup>
      <_NamedBlobsReference>&lt;PackageReference Include="Microsoft.Azure.WebJobs.Extensions.Storage.Blobs" Version="$(_BlobsExtensionNamed)" /&gt;</_NamedBlobsReference>
      <_FixedBlobsReference>&lt;PackageReference Include="Microsoft.Azure.WebJobs.Extensions.Storage.Blobs" Version="$(_BlobsExtensionFixed)" /&gt;</_FixedBlobsReference>
      <_ExtensionsProject>$([System.IO.File]::ReadAllText($(ExtensionsCsProj)))</_ExtensionsProject>
    </PropertyGroup>
    <Error Condition="!$(_ExtensionsProject.Contains($(_NamedBlobsReference))) AND !$(_ExtensionsProject.Contains($(_FixedBlobsReference)))"
           Text="The worker package no longer names blob extension $(_BlobsExtensionNamed); remove _PinFixedBlobsExtension." />
    <WriteLinesToFile Condition="$(_ExtensionsProject.Contains($(_NamedBlobsReference)))" File="$(ExtensionsCsProj)"
                      Lines="$([MSBuild]::Escape($(_ExtensionsProject.Replace($(_NamedBlobsReference), $(_FixedBlobsReference)))))" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="Dbosoft.Bote.Rebus.IntegrationTests" />
    <InternalsVisibleTo Include="Dbosoft.Bote.BoteWorker.Tests" />
  </ItemGroup>
</Project>